/* ━━━━━━━━━━━━━━━━━━━ STATE ━━━━━━━━━━━━━━━━━━━ */

let state;
let currentSlide = 0;
let onboardingShown = false;
let animationInProgress = false;

function freshState() {
  return {
    round:1,
    phase:'play',         // 'play' | 'animating' | 'resolution'
    activeAI: null,       // index of AI player currently "thinking"
    hands: Array.from({length:NUM_PLAYERS}, ()=>[]),
    table:[],
    tokens: TOKENS.map(t => ({ ...t, score:t.startScore, lastDelta:0 })),
    log:[],
    explanations:[],
    counts:{},
    netCounts:{},
    revealedCounts: 0,
    revealedLogs: 0,
    revealedExplanations: 0,
    showResolutionPanel: false,
    gameOver:false,
    result:null,
  };
}

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function init() {
  state = freshState();
  const deck = shuffle(CARDS);
  for (let i = 0; i < HAND_SIZE * NUM_PLAYERS; i++) {
    state.hands[i % NUM_PLAYERS].push(deck[i]);
  }
  render();
}

const delay = ms => new Promise(r => setTimeout(r, ms));

/* ━━━━━━━━━━━━━━━━━━━ GAME LOGIC ━━━━━━━━━━━━━━━━━━━ */

async function playerPick(idx) {
  if (state.phase !== 'play' || state.gameOver || animationInProgress) return;
  animationInProgress = true;
  state.phase = 'animating';

  // Step 1: Player plays
  const playerCard = state.hands[0].splice(idx, 1)[0];
  state.table.push({ ...playerCard, playerSeat: 0, justPlayed: true });
  render();
  await delay(700);
  state.table[state.table.length - 1].justPlayed = false;

  // Step 2-4: AI players play with thinking pause
  for (let p = 1; p < NUM_PLAYERS; p++) {
    state.activeAI = p;
    render();
    await delay(650);

    const r = Math.floor(Math.random() * state.hands[p].length);
    const c = state.hands[p].splice(r, 1)[0];
    state.table.push({ ...c, playerSeat: p, justPlayed: true });
    state.activeAI = null;
    render();
    await delay(450);
    state.table[state.table.length - 1].justPlayed = false;
  }

  await delay(500);

  // Step 5: Compute resolution
  computeResolution();
  state.showResolutionPanel = true;
  render();

  // Step 6: Reveal counts one by one
  await delay(300);
  for (let i = 0; i < 6; i++) {
    state.revealedCounts = i + 1;
    render();
    await delay(160);
  }

  // Step 7: Apply movements to tracker (animated via CSS transition)
  await delay(300);
  applyMovements();
  render();

  // Step 8: Reveal log items
  await delay(500);
  for (let i = 0; i < state.log.length; i++) {
    state.revealedLogs = i + 1;
    render();
    await delay(200);
  }

  // Step 9: Reveal explanations
  await delay(300);
  for (let i = 0; i < 6; i++) {
    state.revealedExplanations = i + 1;
    render();
    await delay(150);
  }

  state.phase = 'resolution';
  animationInProgress = false;
  render();
}

function computeResolution() {
  const t = state.table;
  const log = [];

  const blockersOnTable = t.filter(c => c.blocker);
  const countersOnTable = t.filter(c => c.counters);
  const activeBlockers = blockersOnTable.filter(b =>
    !countersOnTable.some(c => c.counters === b.blocker)
  );
  const cancelledBlockers = blockersOnTable.filter(b =>
    countersOnTable.some(c => c.counters === b.blocker)
  );

  cancelledBlockers.forEach(b => log.push({ type:'good', text:`${b.name} neutralised by counter.` }));
  activeBlockers.forEach(b => log.push({ type:'bad', text:`${b.name} active — no counter played.` }));

  const positive = { P:0, L:0, C:0, A:0, W:0, E:0 };
  const harmHits = { P:0, L:0, C:0, A:0, W:0, E:0 };
  t.forEach(c => { if (c.tokens) c.tokens.forEach(tok => positive[tok]++); });
  activeBlockers.forEach(b => { if (b.harm) b.harm.forEach(tok => harmHits[tok]++); });

  const netCounts = {};
  Object.keys(positive).forEach(k => {
    netCounts[k] = (positive[k] * POSITIVE_VALUE) + (harmHits[k] * BLOCKER_HIT_VALUE);
  });

  // Plan token movements (will be applied later via applyMovements)
  state.pendingMoves = {};
  state.tokens.forEach(tok => {
    let delta = netCounts[tok.id];
    delta = Math.max(-MAX_DELTA, Math.min(MAX_DELTA, delta));
    const newScore = Math.max(SCALE_MIN, Math.min(SCALE_MAX, tok.score + delta));
    state.pendingMoves[tok.id] = newScore - tok.score;
  });

  // Plan balance bonus
  state.pendingBonusTokenId = null;
  const suitsRep = new Set(t.map(c => c.suit));
  if (suitsRep.size === 4) {
    // simulate scores after movement
    const projected = state.tokens.map(tok => ({
      id: tok.id, name: tok.name,
      score: Math.max(SCALE_MIN, Math.min(SCALE_MAX, tok.score + state.pendingMoves[tok.id])),
    }));
    const candidates = projected.filter(p => p.score < SCALE_MAX).sort((a,b) => a.score - b.score);
    if (candidates.length > 0) {
      state.pendingBonusTokenId = candidates[0].id;
      log.push({ type:'good', text:`Balance bonus: all four suits played — ${candidates[0].name} gains an extra point.` });
    }
  }

  // Build explanations
  const explanations = [];
  state.tokens.forEach(tok => {
    const pos = positive[tok.id];
    const hits = harmHits[tok.id];
    const net = netCounts[tok.id];
    let plannedDelta = state.pendingMoves[tok.id];
    if (state.pendingBonusTokenId === tok.id) plannedDelta += 1;
    let body = '';

    if (state.pendingBonusTokenId === tok.id && net <= 0) {
      body = `Balance bonus moved her up. No card directly helped her, but the village played all four suits together — and that lifts the weakest member by one point.`;
    } else if (plannedDelta > 0) {
      const helpers = t.filter(c => c.tokens && c.tokens.includes(tok.id)).map(c => c.name);
      body = `${pos} card${pos !== 1 ? 's' : ''} helped her`;
      if (hits > 0) body += `, but ${hits} blocker hit${hits > 1 ? 's' : ''} cost ${hits*2} points`;
      body += `. Net: +${plannedDelta}. ${helpers.length > 0 ? 'Helped by: ' + helpers.join(', ') + '.' : ''}`;
    } else if (plannedDelta < 0) {
      const harmCards = activeBlockers.filter(b => b.harm && b.harm.includes(tok.id)).map(b => b.name);
      body = `${pos} card${pos !== 1 ? 's' : ''} helped her, but ${hits} blocker hit${hits > 1 ? 's' : ''} cost ${hits*2}. Net: ${plannedDelta}. Harmed by: ${harmCards.join(', ')}.`;
    } else if (tok.score >= SCALE_MAX) {
      body = `Already at maximum Hb 13. Stays.`;
    } else if (net === 0) {
      body = `No card on the table specifically helped or harmed her this round.`;
    } else if (tok.score === SCALE_MIN && net < 0) {
      body = `Blocker pressure, but she's already at 0. Can't drop further.`;
    } else if (net > 0) {
      body = `${pos} positive icon${pos !== 1 ? 's' : ''} — below the threshold to move (needs net 2 or more).`;
    } else {
      body = `Net pressure too small to register a change.`;
    }

    explanations.push({ tokenId: tok.id, delta: plannedDelta, body, pos, hits });
  });

  state.log = log;
  state.counts = positive;
  state.netCounts = netCounts;
  state.explanations = explanations;
}

function applyMovements() {
  state.tokens.forEach(tok => {
    const move = state.pendingMoves[tok.id];
    tok.score = Math.max(SCALE_MIN, Math.min(SCALE_MAX, tok.score + move));
    tok.lastDelta = move;
  });
  if (state.pendingBonusTokenId) {
    const t = state.tokens.find(x => x.id === state.pendingBonusTokenId);
    t.score = Math.min(SCALE_MAX, t.score + 1);
    t.lastDelta += 1;
  }
}

function nextRound() {
  if (animationInProgress) return;
  state.round++;
  state.table = [];
  state.phase = 'play';
  state.tokens.forEach(t => t.lastDelta = 0);
  state.revealedCounts = 0;
  state.revealedLogs = 0;
  state.revealedExplanations = 0;
  state.showResolutionPanel = false;
  if (state.round > MAX_ROUNDS || state.hands[0].length === 0) {
    endGame();
    render();
    return;
  }
  render();
}

function endGame() {
  state.gameOver = true;
  const scores = state.tokens.map(t => t.score);
  const avg = scores.reduce((a, b) => a + b, 0) / scores.length;
  const inSevere = scores.filter(s => s < 8).length;
  const atOrAboveMild = scores.filter(s => s >= 11).length;
  const atNormal = scores.filter(s => s >= 12).length;

  let tier, label, text;
  if (atNormal === 6) {
    tier = 'strong'; label = 'Strong win';
    text = `Every woman in the village reached healthy Hb. The best possible outcome — what the real project's three years of intervention looks like, compressed into seven rounds.`;
  } else if (atOrAboveMild >= 5 && inSevere === 0) {
    tier = 'win'; label = 'Win';
    text = `The village is now mostly above mild anaemia. Some women are healthy, none are in critical territory. A solid intervention.`;
  } else if (inSevere === 0) {
    tier = 'survival'; label = 'Survival';
    text = `Nobody is in severe anaemia anymore, but the village still has more to do. This is the minimum acceptable outcome — where the project's first year often lands.`;
  } else {
    tier = 'loss'; label = 'Did not finish';
    text = `${inSevere} ${inSevere === 1 ? 'woman remains' : 'women remain'} in severe anaemia. Either the blockers hit too hard, or the village couldn't coordinate counters in time.`;
  }
  state.result = { tier, label, text, avg, inSevere, atNormal };
}

function restart() {
  if (animationInProgress) return;
  init();
}

/* ━━━━━━━━━━━━━━━━━━━ MODAL CONTROL ━━━━━━━━━━━━━━━━━━━ */

function showOnboarding() {
  currentSlide = 0;
  renderSlide();
  document.getElementById('onboarding').classList.add('visible');
}

function openOnboarding() { showOnboarding(); }

function closeOnboarding() {
  document.getElementById('onboarding').classList.remove('visible');
  if (!onboardingShown) {
    onboardingShown = true;
    setTimeout(() => {
      document.getElementById('tip-modal').classList.add('visible');
    }, 350);
  }
}

function closeTip() {
  document.getElementById('tip-modal').classList.remove('visible');
}

function renderSlide() {
  const body = document.getElementById('modal-body');
  body.innerHTML = SLIDES[currentSlide]();
  document.getElementById('modal-eyebrow').textContent = `Introduction · ${currentSlide + 1} of ${SLIDES.length}`;
  document.getElementById('back-btn').disabled = currentSlide === 0;
  const nextBtn = document.getElementById('next-btn');
  nextBtn.textContent = currentSlide === SLIDES.length - 1 ? 'Start playing →' : 'Next →';

  const dots = document.getElementById('slide-dots');
  dots.innerHTML = SLIDES.map((_, i) =>
    `<span class="slide-dot${i === currentSlide ? ' active' : ''}"></span>`
  ).join('');
}

function nextSlide() {
  if (currentSlide < SLIDES.length - 1) {
    currentSlide++;
    renderSlide();
  } else {
    closeOnboarding();
  }
}

function prevSlide() {
  if (currentSlide > 0) {
    currentSlide--;
    renderSlide();
  }
}

/* ━━━━━━━━━━━━━━━━━━━ RENDER ━━━━━━━━━━━━━━━━━━━ */

function esc(s) {
  return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]);
}

function tokenChip(id, size = 26) {
  const t = TOKENS.find(x => x.id === id);
  const fontSize = size >= 30 ? 14 : (size >= 22 ? 12 : 10);
  return `<span class="token-chip" style="background:${t.color}; width:${size}px; height:${size}px; font-size:${fontSize}px">${id}</span>`;
}

function cardIcon(id, harm) {
  const t = TOKENS.find(x => x.id === id);
  return `<span class="card-icon${harm ? ' harm' : ''}" style="${harm ? 'border-color:' + t.color + ';color:' + t.color : 'background:' + t.color}" title="${t.name}">${id}</span>`;
}

function scoreToPercent(s) {
  return ((s - SCALE_MIN) / SCALE_RANGE) * 100;
}

function renderCard(c, opts = {}) {
  const isBlocker = !!c.blocker;
  const isCounter = !!c.counters;
  const cls = ['card', `suit-${c.suit}`];
  if (isBlocker) cls.push('blocker');
  if (isCounter) cls.push('counter');
  if (opts.played) cls.push('played');
  if (opts.disabled) cls.push('disabled');
  if (c.justPlayed) cls.push('entering');

  let onClick = '';
  if (opts.onClick) onClick = `onclick="${opts.onClick}"`;

  let tagHtml = '';
  if (isBlocker) tagHtml = `<span class="card-tag blocker">Blocker</span>`;
  else if (isCounter) tagHtml = `<span class="card-tag counter">Counter</span>`;

  let iconsHtml = '<div class="card-icons">';
  if (c.tokens) c.tokens.forEach(t => iconsHtml += cardIcon(t, false));
  if (c.harm) c.harm.forEach(t => iconsHtml += cardIcon(t, true));
  iconsHtml += '</div>';

  return `<div class="${cls.join(' ')}" ${onClick}>
    <div class="card-suit-tag">${SUITS[c.suit].label}</div>
    <div class="card-name">${esc(c.name)}</div>
    ${tagHtml}
    ${iconsHtml}
  </div>`;
}

function render() {
  // Header
  document.getElementById('round-num').innerHTML = `${Math.min(state.round, MAX_ROUNDS)}<span>/${MAX_ROUNDS}</span>`;
  let phaseText;
  if (state.gameOver) phaseText = 'Game complete';
  else if (state.phase === 'play') phaseText = 'Your turn';
  else if (state.phase === 'animating') {
    if (state.activeAI) phaseText = `Player ${state.activeAI + 1} is thinking…`;
    else if (state.showResolutionPanel) phaseText = 'Calculating…';
    else phaseText = 'Playing…';
  } else phaseText = 'Round complete';
  document.getElementById('phase').textContent = phaseText;

  const main = document.getElementById('main');

  if (state.gameOver) {
    main.innerHTML = `<div class="end-screen-wrap">${renderEndScreen()}</div>`;
    return;
  }

  let html = '';
  html += renderTracker();
  html += `<div class="play-row">${renderTable()}${renderSide()}</div>`;

  if (state.showResolutionPanel) {
    html += renderResolution();
    if (state.phase === 'resolution') {
      html += `<div class="actions"><button class="primary" onclick="nextRound()">${state.round >= MAX_ROUNDS ? 'See final result →' : 'Continue to next round →'}</button></div>`;
    }
  } else {
    html += renderHand();
  }

  main.innerHTML = html;
}

function renderTracker() {
  let html = `<div class="tracker">
    <div class="tracker-head">
      <div></div>
      <div></div>
      <div class="scale-zones">
        <span>Severe</span>
        <span>Moderate</span>
        <span>Mild</span>
        <span>Normal</span>
      </div>
      <div class="head-label">Hb</div>
      <div class="head-label">Δ</div>
    </div>`;

  state.tokens.forEach(tok => {
    const delta = tok.lastDelta;
    const cls = ['token-row'];
    if (state.showResolutionPanel && delta > 0) cls.push('changed-up');
    if (state.showResolutionPanel && delta < 0) cls.push('changed-down');

    const deltaText = delta > 0 ? `+${delta}` : (delta < 0 ? `${delta}` : '—');
    const deltaCls = delta > 0 ? 'up' : (delta < 0 ? 'down' : 'flat');
    const showDelta = state.showResolutionPanel;

    const markerLeft = scoreToPercent(tok.score);

    html += `<div class="${cls.join(' ')}">
      <div>${tokenChip(tok.id, 26)}</div>
      <div>
        <div class="token-name">${tok.name}</div>
        <div class="token-name-sub">${tok.sub}</div>
      </div>
      <div class="scale-bar">
        <div class="scale-zone severe"></div>
        <div class="scale-zone moderate"></div>
        <div class="scale-zone mild"></div>
        <div class="scale-zone normal"></div>
        <div class="scale-tick" style="left:61.54%"></div>
        <div class="scale-tick" style="left:84.62%"></div>
        <div class="scale-tick" style="left:92.31%"></div>
        <div class="scale-marker" style="left:${markerLeft}%; background:${tok.color}"></div>
      </div>
      <div>
        <div class="token-score">${tok.score}</div>
        <div class="token-score-sub">gm%</div>
      </div>
      <div class="token-delta ${deltaCls}">${showDelta ? deltaText : ''}</div>
    </div>`;
  });

  html += `</div>`;
  return html;
}

function renderTable() {
  let html = `<div class="table-area">
    <div class="area-head">
      <div class="section-title">On the Table</div>
      <div class="area-note">${state.table.length} of 4 cards</div>
    </div>
    <div class="table-cards">`;

  for (let i = 0; i < 4; i++) {
    if (state.table[i]) {
      html += renderCard(state.table[i], { played: true });
    } else {
      // Mark the next-to-be-played slot as "waiting" if an AI is thinking
      const isWaiting = state.activeAI === i;
      html += `<div class="slot${isWaiting ? ' waiting' : ''}">${isWaiting ? 'Player ' + (i+1) + ' playing' : 'Empty'}</div>`;
    }
  }
  html += `</div></div>`;
  return html;
}

function renderSide() {
  let html = `<div class="side-area">
    <div class="section-title" style="margin-bottom:8px">Other Players</div>
    <div class="opponents">`;

  for (let p = 1; p < NUM_PLAYERS; p++) {
    const thinking = state.activeAI === p;
    html += `<div class="opp${thinking ? ' thinking' : ''}">
      <div class="opp-head">
        <div class="opp-name">Player ${p + 1}</div>
        <div class="opp-count">${state.hands[p].length}</div>
      </div>
      <div class="opp-cards">`;
    state.hands[p].forEach(c => { html += `<div class="opp-card s-${c.suit}"></div>`; });
    html += `</div>`;
    if (thinking) html += `<div class="opp-thinking-text">Choosing a card…</div>`;
    html += `</div>`;
  }
  html += `</div></div>`;
  return html;
}

function renderHand() {
  const handDisabled = state.phase !== 'play';
  let html = `<div class="hand-area">
    <div class="area-head">
      <div class="section-title">Your Hand</div>
      <div class="area-note">${state.hands[0].length} cards · click one to play</div>
    </div>
    <div class="hand-grid">`;

  state.hands[0].forEach((c, i) => {
    html += renderCard(c, {
      onClick: handDisabled ? '' : `playerPick(${i})`,
      disabled: handDisabled,
    });
  });

  html += `</div></div>`;
  return html;
}

function renderResolution() {
  let html = `<div class="resolution-area">
    <div>
      <div class="res-block-title">Net Movement</div>
      <div class="icon-counts">`;
  TOKENS.forEach((tok, i) => {
    const net = state.netCounts[tok.id] || 0;
    const t = state.tokens.find(t => t.id === tok.id);
    const d = t.lastDelta || (state.pendingMoves ? state.pendingMoves[tok.id] : 0);
    const cls = d > 0 ? 'up' : (d < 0 ? 'down' : '');
    const isVisible = i < state.revealedCounts;
    const display = net >= 0 ? `+${net}` : `${net}`;
    html += `<div class="count-cell ${cls}${isVisible ? ' visible' : ''}">
      <div class="count-cell-chip" style="background:${tok.color}">${tok.id}</div>
      <div class="count-cell-num">${display}</div>
    </div>`;
  });
  html += `</div>
    <ul class="log-list">`;
  state.log.forEach((l, i) => {
    const isVisible = i < state.revealedLogs;
    html += `<li class="log-item ${l.type}${isVisible ? ' visible' : ''}">${esc(l.text)}</li>`;
  });
  if (state.log.length === 0 && state.revealedLogs > 0) {
    html += `<li class="log-item visible">No blockers active this round.</li>`;
  }
  html += `</ul></div>

    <div>
      <div class="res-block-title">Why each woman moved or stayed</div>
      <div class="exp-list">`;
  state.explanations.forEach((e, i) => {
    const tok = TOKENS.find(t => t.id === e.tokenId);
    const isVisible = i < state.revealedExplanations;
    const deltaCls = e.delta > 0 ? 'up' : (e.delta < 0 ? 'down' : 'flat');
    const deltaText = e.delta > 0 ? `+${e.delta}` : (e.delta < 0 ? `${e.delta}` : '—');
    html += `<div class="exp-item${isVisible ? ' visible' : ''}">
      <div><span class="exp-chip" style="background:${tok.color}">${e.tokenId}</span></div>
      <div>
        <div class="exp-head">
          <div class="exp-name">${tok.name}</div>
          <div class="exp-delta ${deltaCls}">${deltaText} Hb</div>
        </div>
        <div class="exp-body">${esc(e.body)}</div>
      </div>
    </div>`;
  });
  html += `</div></div></div>`;
  return html;
}

function renderEndScreen() {
  const { tier, label, text, avg } = state.result;
  const inSevere = state.tokens.filter(t => t.score < 8).length;
  const atOrAboveMild = state.tokens.filter(t => t.score >= 11).length;

  return `<div class="end-screen">
    <div class="end-eyebrow">Game over · 7 rounds complete</div>
    <h2 class="end-title ${tier}">${label}</h2>
    <p class="end-text">${esc(text)}</p>
    <div class="end-stats">
      <div>
        <div class="end-stat-label">Average Hb</div>
        <div class="end-stat-value">${avg.toFixed(1)}</div>
      </div>
      <div>
        <div class="end-stat-label">Mild or healthy</div>
        <div class="end-stat-value">${atOrAboveMild}<span style="font-size:16px;color:var(--ink-3)"> / 6</span></div>
      </div>
      <div>
        <div class="end-stat-label">Still severe</div>
        <div class="end-stat-value">${inSevere}<span style="font-size:16px;color:var(--ink-3)"> / 6</span></div>
      </div>
    </div>
    <p class="end-note">For reference: the real Mata Kanikansari project moved village average Hb from 9.7 to 11.7 over three years — a gain of +2.0 points.</p>
    <button class="primary" onclick="restart()">Play another round</button>
  </div>`;
}

