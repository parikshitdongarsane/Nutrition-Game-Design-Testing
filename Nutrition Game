<script>
"use strict";

/* ━━━━━━━━━━━━━━━━━━━ DATA ━━━━━━━━━━━━━━━━━━━ */

const TOKENS = [
  { id:'P', name:'Pregnant woman',  sub:'Highest acute need',  color:'#B8344E', startScore:0 },
  { id:'L', name:'Lactating mother',sub:'Feeding the baby',    color:'#C16285', startScore:0 },
  { id:'C', name:'Young child',     sub:'First 1000 days',     color:'#D08B3E', startScore:0 },
  { id:'A', name:'Adolescent girl', sub:'Monthly iron loss',   color:'#2E69A1', startScore:0 },
  { id:'W', name:'Adult woman',     sub:'Household sustainer', color:'#6B5BB5', startScore:0 },
  { id:'E', name:'Older woman',     sub:'Declining absorption',color:'#6F6963', startScore:0 },
];

const SUITS = {
  avail:  { name:'Availability', label:'AVAILABILITY', desc:'What food exists in the household — vegetables, grains, eggs, fruits, the iron supplement from the health worker.' },
  access: { name:'Access',       label:'ACCESS',       desc:'How food reaches the plate — buying, sharing, the Anganwadi centre, and who at home eats first.' },
  util:   { name:'Utilisation',  label:'UTILISATION',  desc:'What happens in the kitchen and the body — iron pots, lemon for absorption, soaking, fermentation, hygiene.' },
  stab:   { name:'Stability',    label:'STABILITY',    desc:'Sustaining the system — seed saving, year-round gardens, preservation, women\'s groups, water sources.' },
};

const CARDS = [
  { key:'jowar',         suit:'avail',  name:'Jowar',                          tokens:['P','A','C','W'] },
  { key:'wild_greens',   suit:'avail',  name:'Wild leafy greens',              tokens:['P','A','C'] },
  { key:'nagali',        suit:'avail',  name:'Nagali (ragi)',                  tokens:['P','A','C','E'] },
  { key:'dal',           suit:'avail',  name:'Dal and pulses',                 tokens:['P','L','C','A'] },
  { key:'eggs_poultry',  suit:'avail',  name:'Backyard eggs & poultry',        tokens:['P','L','C','A'] },
  { key:'ifa',           suit:'avail',  name:'Iron supplement (IFA)',          tokens:['P','A','L'] },
  { key:'fruits',        suit:'avail',  name:'Seasonal fruits',                tokens:['P','A','C'] },
  { key:'curd',          suit:'avail',  name:'Curd and buttermilk',            tokens:['L','C','E'] },
  { key:'tubers',        suit:'avail',  name:'Tubers and roots',               tokens:['W','E','C'] },

  { key:'family_budget', suit:'access', name:'Family budget',                  tokens:['P','A','C'] },
  { key:'anganwadi',     suit:'access', name:'Anganwadi support',              tokens:['P','L','C'] },
  { key:'pds',           suit:'access', name:'PDS ration',                     tokens:['W','E'] },
  { key:'family_meal',   suit:'access', name:'Family meal together',           tokens:['C','A'] },
  { key:'mother_first',  suit:'access', name:'Mother eats first',              tokens:['P','L','A'], counters:'eats_last' },
  { key:'recipe_taught', suit:'access', name:'Recipe taught',                  tokens:['P','L'], counters:'food_taboos' },
  { key:'affordable',    suit:'access', name:'Affordable food',                tokens:['P','A'] },
  { key:'food_taboos',   suit:'access', name:'Food taboos in pregnancy',       harm:['P','L'], blocker:'food_taboos' },
  { key:'eats_last',     suit:'access', name:'Woman eats last',                harm:['P','L','A','C'], blocker:'eats_last' },

  { key:'iron_kadhai',   suit:'util',   name:'Iron kadhai',                    tokens:['P','A','C'], counters:'aluminium' },
  { key:'lemon',         suit:'util',   name:'Lemon with meal',                tokens:['P','A','C'] },
  { key:'jaggary',       suit:'util',   name:'Jaggary with meal',              tokens:['P','A','C'] },
  { key:'soaking',       suit:'util',   name:'Soaking pulses',                 tokens:['C','A','E'] },
  { key:'fermented',     suit:'util',   name:'Fermented foods',                tokens:['L','C','E'] },
  { key:'fresh_cooked',  suit:'util',   name:'Fresh-cooked meal',              tokens:['P','L','C','A','W','E'], counters:'stale' },
  { key:'handwashing',   suit:'util',   name:'Handwashing',                    tokens:['P','L','C'] },
  { key:'aluminium',     suit:'util',   name:'Aluminium cookware',             harm:['P','A','C'], blocker:'aluminium' },
  { key:'stale',         suit:'util',   name:'Stale food',                     harm:['L','C','E'], blocker:'stale' },

  { key:'seed_saving',   suit:'stab',   name:'Seed saving',                    tokens:['W','E'], counters:'migration' },
  { key:'kitchen_garden',suit:'stab',   name:'Kitchen garden',                 tokens:['P','A','C'] },
  { key:'preservation',  suit:'stab',   name:'Preservation',                   tokens:['L','E','C'] },
  { key:'grain_storage', suit:'stab',   name:'Grain storage',                  tokens:['W','E'], counters:'migration' },
  { key:'water_source',  suit:'stab',   name:'Water source',                   tokens:['P','L','C','E'] },
  { key:'pass_recipes',  suit:'stab',   name:'Pass on recipes',                tokens:['W','E'] },
  { key:'bachat_gat',    suit:'stab',   name:'Bachat gat',                     tokens:['P','L'], counters:'tobacco' },
  { key:'tobacco',       suit:'stab',   name:'Tobacco',                        harm:['P','L','C'], blocker:'tobacco' },
  { key:'migration',     suit:'stab',   name:'Migration disruption',           harm:['P','L','C','A','W','E'], blocker:'migration' },
];

const SCALE_MIN = 0, SCALE_MAX = 13;
const SCALE_RANGE = SCALE_MAX - SCALE_MIN;
const HAND_SIZE = 7;
const NUM_PLAYERS = 4;
const MAX_ROUNDS = 7;
const POSITIVE_VALUE = 1;
const BLOCKER_HIT_VALUE = -2;
const MAX_DELTA = 4;

/* ━━━━━━━━━━━━━━━━━━━ ONBOARDING SLIDES ━━━━━━━━━━━━━━━━━━━ */

const SLIDES = [
  // Slide 1 — Welcome
  () => `
    <div class="slide-title">A village in seven rounds</div>
    <div class="slide-lead">You're playing a cooperative card game about women's nutrition in the tribal villages of Akkalkuwa, Nandurbar. Six women, all anaemic. You and three other players have seven rounds to lift them out of it — together.</div>
    <div class="slide-content">
      <p>This is a <strong>tester</strong>. You play as one of four players; the other three play random cards. In the real game, all four are people sitting around the table, talking to each other.</p>
      <p>You can't win alone, and you can't avoid the village's problems. The deck contains <strong>six harmful practices</strong> — tobacco, aluminium cookware, stale food, food taboos, household inequity, seasonal migration — and every one of them will hit the table during the game. What you can do is respond.</p>
    </div>
  `,

  // Slide 2 — The Village
  () => `
    <div class="slide-title">The six women</div>
    <div class="slide-lead">Every game starts the same way: six tokens, all at zero. Each represents a woman in the village at a different life stage. Each has different nutritional priorities.</div>
    <div class="slide-illust">
      <div class="token-row-demo">
        ${TOKENS.map(t => `
          <div class="token-demo">
            <span class="token-chip" style="background:${t.color}">${t.id}</span>
            <div class="token-demo-info">
              <div class="token-demo-name">${t.name}</div>
              <div class="token-demo-sub">${t.sub}</div>
            </div>
          </div>
        `).join('')}
      </div>
    </div>
    <div class="slide-content">
      <p>Their haemoglobin runs on a scale from <strong>0 to 13</strong>. Below 8 is severe anaemia. 8 to 11 is moderate. 11 to 12 is mild. 12+ is healthy. Your job is to raise their numbers as far as you can in seven rounds.</p>
    </div>
  `,

  // Slide 3 — The four suits
  () => `
    <div class="slide-title">Four suits, four pillars</div>
    <div class="slide-lead">The 36-card deck has nine cards in each of four suits — the four pillars of food security in the FAO framework.</div>
    <div class="slide-illust">
      <div class="suit-demo">
        ${Object.entries(SUITS).map(([k, s]) => `
          <div class="suit-card ${k}">
            <div class="suit-card-name">${s.name}</div>
            <div class="suit-card-text">${s.desc}</div>
          </div>
        `).join('')}
      </div>
    </div>
    <div class="slide-content">
      <p>Each card has a coloured stripe at the top showing its suit. Play <strong>all four suits in one round</strong> and the lowest-scoring woman gets a bonus +1.</p>
    </div>
  `,

  // Slide 4 — Cards and icons
  () => `
    <div class="slide-title">Cards carry priority icons</div>
    <div class="slide-lead">Every card has small coloured letters in its bottom corner. Each letter is one of the six women. The icons tell you which women this card most directly helps.</div>
    <div class="card-anatomy">
      <div class="anatomy-card">
        <div class="card-suit-tag" style="color: var(--avail)">AVAILABILITY</div>
        <div class="card-name" style="font-family: var(--font-display); font-size: 14px; font-weight: 500; margin-bottom: 8px">Backyard eggs &amp; poultry</div>
        <div class="card-icons">
          ${['P','L','C','A'].map(id => {
            const t = TOKENS.find(x => x.id === id);
            return `<span class="card-icon" style="background:${t.color}">${id}</span>`;
          }).join('')}
        </div>
      </div>
      <div class="anatomy-callouts">
        <ul style="list-style:none; padding:0">
          <li><strong>Stripe</strong> · the colour tells you which suit this card belongs to.</li>
          <li><strong>Name</strong> · the food or practice the card represents.</li>
          <li><strong>Icons</strong> · the women this card helps. Eggs help Pregnant (P), Lactating (L), Young child (C), and Adolescent (A) — the four growing bodies.</li>
        </ul>
      </div>
    </div>
    <div class="slide-content">
      <p>Each icon on the table is <strong>worth +1</strong> for that woman. So a Backyard eggs card adds one point to all four women whose icons it carries.</p>
    </div>
  `,

  // Slide 5 — Blockers and counters
  () => `
    <div class="slide-title">Blockers and counters</div>
    <div class="slide-lead">Six cards in the deck are blockers — real harmful practices the project worked to change. Each one harms specific women. Each one has a counter that cancels it.</div>
