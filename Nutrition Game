<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1280, initial-scale=1">
<title>Mata Kanikansari · Card Game Tester</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --font-display: "Fraunces", Georgia, serif;
  --font-body: "IBM Plex Sans", -apple-system, "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", "SF Mono", Consolas, monospace;

  --bg-page: #F7F3EA;
  --bg-paper: #FFFDF7;
  --bg-soft: #F0EAD8;

  --ink-1: #1A1611;
  --ink-2: #3D362C;
  --ink-3: #807769;
  --ink-4: #B0A799;
  --line: #E8E2D2;
  --line-strong: #C4BDB0;

  --avail: #2D5530;
  --avail-soft: #E8F0E1;
  --access: #2C5985;
  --access-soft: #DEE9F2;
  --util: #4E3F73;
  --util-soft: #E5E0EF;
  --stab: #9A6B1F;
  --stab-soft: #F2E5CD;

  --t-P: #B8344E;
  --t-L: #C16285;
  --t-C: #D08B3E;
  --t-A: #2E69A1;
  --t-W: #6B5BB5;
  --t-E: #6F6963;

  --good: #4A8264;
  --good-soft: #DCEEDE;
  --bad: #B8344E;
  --bad-soft: #F7D9DC;
  --warn: #C77F2C;
  --warn-soft: #FCE9D0;

  --severe-bg: #F8DCDC;
  --moderate-bg: #F8E3C5;
  --mild-bg: #E6EDC5;
  --normal-bg: #D2E5D8;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { background: var(--bg-page); height: 100%; overflow: hidden; }

body {
  font-family: var(--font-body);
  font-size: 13px;
  line-height: 1.45;
  color: var(--ink-1);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-feature-settings: "ss01", "ss02", "cv11";
}

/* ━━━ APP CONTAINER ━━━ */
.app {
  max-width: 1340px;
  height: 100vh;
  margin: 0 auto;
  padding: 16px 28px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  overflow: hidden;
}

/* ━━━ HEADER ━━━ */
.header {
  display: grid;
  grid-template-columns: 1fr auto auto auto;
  align-items: center;
  gap: 24px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
  flex-shrink: 0;
}

.brand-line { display: flex; align-items: baseline; gap: 14px; }

.brand-title {
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.015em;
  line-height: 1;
  color: var(--ink-1);
  font-style: italic;
}

.brand-sub {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--ink-3);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 500;
}

.status { text-align: right; }

.status .round-num {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 400;
  line-height: 1;
  color: var(--ink-1);
}

.status .round-num span { font-size: 14px; color: var(--ink-3); }

.status .phase {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--ink-3);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-top: 4px;
}

button.iconbtn {
  font-family: var(--font-body);
  font-size: 11px;
  background: transparent;
  border: 1px solid var(--line-strong);
  padding: 8px 12px;
  color: var(--ink-2);
  cursor: pointer;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 500;
  transition: all 0.18s ease;
  border-radius: 2px;
}

button.iconbtn:hover {
  background: var(--ink-1);
  color: var(--bg-paper);
  border-color: var(--ink-1);
}

/* ━━━ MAIN GAME AREA ━━━ */
.main {
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex: 1;
  min-height: 0;
}

.section-title {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-3);
  font-weight: 500;
}

/* ━━━ TRACKER ━━━ */
.tracker {
  background: var(--bg-paper);
  border: 1px solid var(--line);
  padding: 12px 18px 8px;
  border-radius: 4px;
  flex-shrink: 0;
}

.tracker-head {
  display: grid;
  grid-template-columns: 28px 140px 1fr 56px 46px;
  gap: 14px;
  align-items: end;
  margin-bottom: 6px;
  padding-bottom: 4px;
  border-bottom: 1px solid var(--line);
}

.tracker-head .scale-zones {
  display: grid;
  grid-template-columns: 61.54% 23.08% 7.69% 7.69%;
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
}

.scale-zones span:nth-child(1) { color: #8A2929; }
.scale-zones span:nth-child(2) { color: #8A571B; }
.scale-zones span:nth-child(3) { color: #4F6716; }
.scale-zones span:nth-child(4) { color: #1F5933; }

.tracker-head .head-label {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-3);
  text-align: right;
}

.token-row {
  display: grid;
  grid-template-columns: 28px 140px 1fr 56px 46px;
  gap: 14px;
  align-items: center;
  padding: 5px 0;
  border-top: 1px solid var(--line);
  position: relative;
}

.token-row:first-of-type { border-top: none; }

.token-row.changed-up::before,
.token-row.changed-down::before {
  content: '';
  position: absolute; inset: 0;
  pointer-events: none;
  border-radius: 2px;
}
.token-row.changed-up::before { background: linear-gradient(90deg, rgba(74, 130, 100, 0.07), transparent 60%); }
.token-row.changed-down::before { background: linear-gradient(90deg, rgba(184, 52, 78, 0.08), transparent 60%); }

.token-chip {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 600;
  color: var(--bg-paper);
  letter-spacing: -0.02em;
  flex-shrink: 0;
}

.token-name {
  font-family: var(--font-display);
  font-size: 13.5px;
  color: var(--ink-1);
  font-weight: 500;
  line-height: 1.15;
}

.token-name-sub {
  font-family: var(--font-mono);
  font-size: 8.5px;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 1px;
}

.scale-bar {
  position: relative;
  height: 18px;
  border-radius: 2px;
  background: var(--bg-soft);
  border: 1px solid var(--line);
}

.scale-zone { position: absolute; top: 0; bottom: 0; }
.scale-zone.severe { left: 0; width: 61.54%; background: var(--severe-bg); }
.scale-zone.moderate { left: 61.54%; width: 23.08%; background: var(--moderate-bg); }
.scale-zone.mild { left: 84.62%; width: 7.69%; background: var(--mild-bg); }
.scale-zone.normal { left: 92.31%; width: 7.69%; background: var(--normal-bg); }

.scale-tick {
  position: absolute;
  top: -2px;
  bottom: -2px;
  width: 1px;
  background: rgba(26, 22, 17, 0.18);
}

.scale-marker {
  position: absolute;
  top: 50%;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  border: 2px solid var(--bg-paper);
  box-shadow: 0 1px 3px rgba(26, 22, 17, 0.3);
  transition: left 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 2;
}

.token-score {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 500;
  color: var(--ink-1);
  line-height: 1;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.token-score-sub {
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--ink-3);
  letter-spacing: 0.06em;
  text-align: right;
  margin-top: 1px;
  text-transform: uppercase;
}

.token-delta {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 500;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.token-delta.up { color: var(--good); }
.token-delta.down { color: var(--bad); }
.token-delta.flat { color: var(--ink-4); }

/* ━━━ PLAY GRID ━━━ */
.play-row {
  display: grid;
  grid-template-columns: 1fr 256px;
  gap: 12px;
  flex-shrink: 0;
}

.table-area, .side-area {
  background: var(--bg-paper);
  border: 1px solid var(--line);
  border-radius: 4px;
  padding: 12px 16px;
}

.area-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8px;
}

.area-note {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--ink-4);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.table-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

/* ━━━ CARD ━━━ */
.card {
  position: relative;
  background: var(--bg-paper);
  border-radius: 5px;
  padding: 10px 11px 9px;
  border: 1px solid var(--line);
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  display: flex;
  flex-direction: column;
  font-family: var(--font-body);
  text-align: left;
  user-select: none;
  min-height: 138px;
}

.card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  border-radius: 5px 5px 0 0;
}

.card.suit-avail::before { background: var(--avail); }
.card.suit-access::before { background: var(--access); }
.card.suit-util::before { background: var(--util); }
.card.suit-stab::before { background: var(--stab); }

.card:hover:not(.played):not(.disabled) {
  transform: translateY(-4px);
  box-shadow: 0 8px 18px rgba(26, 22, 17, 0.08), 0 2px 5px rgba(26, 22, 17, 0.04);
  border-color: var(--ink-2);
}

.card.played { cursor: default; }
.card.disabled { cursor: not-allowed; opacity: 0.6; }
.card.blocker { background: linear-gradient(160deg, #FBE8E8 0%, var(--bg-paper) 70%); }
.card.counter { background: linear-gradient(160deg, #E3EEDE 0%, var(--bg-paper) 70%); }

.card-suit-tag {
  font-family: var(--font-mono);
  font-size: 8.5px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-top: 2px;
  margin-bottom: 6px;
  font-weight: 500;
}

.card.suit-avail .card-suit-tag { color: var(--avail); }
.card.suit-access .card-suit-tag { color: var(--access); }
.card.suit-util .card-suit-tag { color: var(--util); }
.card.suit-stab .card-suit-tag { color: var(--stab); }

.card-name {
  font-family: var(--font-display);
  font-size: 13.5px;
  font-weight: 500;
  line-height: 1.2;
  color: var(--ink-1);
  flex: 1;
  margin-bottom: 8px;
  letter-spacing: -0.005em;
}

.card-tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 7.5px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 1.5px 5px;
  border-radius: 2px;
  margin-bottom: 5px;
  width: fit-content;
}

.card-tag.blocker { background: var(--bad); color: white; }
.card-tag.counter { background: var(--good); color: white; }

.card-icons {
  display: flex;
  gap: 3px;
  flex-wrap: wrap;
  align-items: center;
}

.card-icon {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 9px;
  font-weight: 600;
  color: var(--bg-paper);
  letter-spacing: -0.04em;
  position: relative;
}

.card-icon.harm { background: transparent !important; border: 1.5px solid; }
.card-icon.harm::after {
  content: '';
  position: absolute;
  top: 50%; left: -1px; right: -1px;
  height: 1.5px;
  background: currentColor;
  transform: rotate(-45deg);
  transform-origin: center;
}

/* ━━━ ANIMATIONS ━━━ */
@keyframes cardSlideIn {
  from { opacity: 0; transform: translateY(20px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes cardBackFlip {
  0% { opacity: 0; transform: rotateY(90deg); }
  100% { opacity: 1; transform: rotateY(0); }
}

.card.entering { animation: cardSlideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) both; }
.card.flipping { animation: cardBackFlip 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both; }

.slot {
  min-height: 138px;
  border: 1px dashed var(--line-strong);
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.14em;
  color: var(--ink-4);
  text-transform: uppercase;
  background: var(--bg-soft);
  opacity: 0.4;
}

.slot.waiting {
  background: var(--bg-paper);
  opacity: 1;
  border-color: var(--access);
  color: var(--access);
}

.slot.waiting::after {
  content: '...';
  font-family: var(--font-mono);
  margin-left: 4px;
  animation: dots 1.2s steps(4, end) infinite;
}

@keyframes dots {
  0%, 20% { color: transparent; text-shadow: .25em 0 0 transparent, .5em 0 0 transparent; }
  40% { color: var(--access); text-shadow: .25em 0 0 transparent, .5em 0 0 transparent; }
  60% { text-shadow: .25em 0 0 var(--access), .5em 0 0 transparent; }
  80%, 100% { text-shadow: .25em 0 0 var(--access), .5em 0 0 var(--access); }
}

/* ━━━ SIDE PANEL ━━━ */
.side-area {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px 14px;
}

.opponents {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.opp {
  padding: 6px 8px;
  background: var(--bg-soft);
  border-radius: 3px;
  border: 1px solid transparent;
  transition: border-color 0.3s;
}

.opp.thinking { border-color: var(--access); background: var(--access-soft); }

.opp-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.opp-name {
  font-family: var(--font-display);
  font-size: 12px;
  color: var(--ink-1);
  font-weight: 500;
}

.opp-count {
  font-family: var(--font-mono);
  font-size: 9.5px;
  color: var(--ink-3);
  font-weight: 500;
  letter-spacing: 0.04em;
}

.opp-cards {
  display: flex;
  gap: 1px;
}

.opp-card {
  width: 10px;
  height: 14px;
  border-radius: 1px;
  opacity: 0.85;
  transition: opacity 0.3s;
}

.opp-card.s-avail { background: var(--avail); }
.opp-card.s-access { background: var(--access); }
.opp-card.s-util { background: var(--util); }
.opp-card.s-stab { background: var(--stab); }

.opp.thinking .opp-card { animation: shimmer 1.4s ease-in-out infinite; }
@keyframes shimmer {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.opp-thinking-text {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--access);
  letter-spacing: 0.08em;
  margin-top: 4px;
  font-weight: 500;
}

/* ━━━ HAND ━━━ */
.hand-area {
  background: var(--bg-paper);
  border: 1px solid var(--line);
  padding: 10px 14px 12px;
  border-radius: 4px;
  flex-shrink: 0;
}

.hand-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10px;
}

/* ━━━ RESOLUTION ━━━ */
.resolution-area {
  background: var(--bg-paper);
  border: 1px solid var(--line);
  border-radius: 4px;
  padding: 12px 16px;
  display: grid;
  grid-template-columns: 360px 1fr;
  gap: 18px;
  flex-shrink: 0;
}

.res-block-title {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 8px;
  font-weight: 500;
}

.icon-counts {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6px;
  margin-bottom: 8px;
}

.count-cell {
  padding: 6px 4px;
  text-align: center;
  border-radius: 3px;
  background: var(--bg-soft);
  border: 1px solid var(--line);
  opacity: 0;
  transform: translateY(4px);
  transition: opacity 0.3s, transform 0.3s, background 0.3s;
}

.count-cell.visible { opacity: 1; transform: translateY(0); }
.count-cell.up { background: var(--good-soft); border-color: var(--good); }
.count-cell.down { background: var(--bad-soft); border-color: var(--bad); }

.count-cell-chip {
  display: inline-flex;
  width: 18px; height: 18px; border-radius: 50%;
  align-items: center; justify-content: center;
  color: white; font-family: var(--font-display);
  font-size: 10px; font-weight: 600;
  margin-bottom: 3px;
}

.count-cell-num {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 500;
  color: var(--ink-1);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.log-list {
  list-style: none;
  font-size: 11.5px;
  line-height: 1.5;
}

.log-item {
  padding: 3px 0;
  color: var(--ink-2);
  opacity: 0;
  transform: translateX(-4px);
  transition: opacity 0.3s, transform 0.3s;
}

.log-item.visible { opacity: 1; transform: translateX(0); }
.log-item.good { color: var(--good); }
.log-item.bad { color: var(--bad); }

.exp-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 14px;
  max-height: 200px;
  overflow-y: auto;
}

.exp-item {
  display: grid;
  grid-template-columns: 22px 1fr;
  gap: 8px;
  padding: 4px 0;
  border-bottom: 1px solid var(--line);
  opacity: 0;
  transform: translateY(4px);
  transition: opacity 0.3s, transform 0.3s;
}

.exp-item.visible { opacity: 1; transform: translateY(0); }
.exp-item:nth-last-child(-n+2) { border-bottom: none; }

.exp-chip {
  width: 20px; height: 20px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-size: 10px; font-weight: 600;
  color: white; letter-spacing: -0.02em;
}

.exp-head {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-bottom: 2px;
}

.exp-name {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 500;
  color: var(--ink-1);
}

.exp-delta {
  font-family: var(--font-mono);
  font-size: 9.5px;
  font-weight: 500;
  padding: 1px 5px;
  border-radius: 2px;
}

.exp-delta.up { background: var(--good-soft); color: var(--good); }
.exp-delta.down { background: var(--bad-soft); color: var(--bad); }
.exp-delta.flat { background: var(--bg-soft); color: var(--ink-3); }

.exp-body {
  font-size: 11px;
  line-height: 1.45;
  color: var(--ink-2);
}

/* ━━━ ACTIONS ━━━ */
.actions {
  display: flex;
  justify-content: center;
  margin-top: 8px;
}

button.primary {
  font-family: var(--font-display);
  font-size: 14px;
  background: var(--ink-1);
  color: var(--bg-paper);
  border: 1px solid var(--ink-1);
  padding: 10px 24px;
  cursor: pointer;
  letter-spacing: 0.02em;
  font-weight: 500;
  transition: all 0.18s;
  border-radius: 3px;
}

button.primary:hover {
  background: var(--ink-2);
  border-color: var(--ink-2);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(26, 22, 17, 0.15);
}

button.primary:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

/* ━━━ MODAL SYSTEM ━━━ */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(26, 22, 17, 0.55);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
